@inherits LayoutComponentBase

<MudThemeProvider DefaultScrollbar="true" IsDarkMode="true"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<div class="page">
    <main>
        <div class="top-row px-4">
            <PlayerHud/>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

    <div class="bottom-bar">
        <NavMenu/>
    </div>
</div>

<style>
    *, body, html, .mud-typography {
        font-family: 'Inter', 'Helvetica', 'Arial', sans-serif !important;
    }

    body, html {
        background-color: #0b0c10 !important;
    }

    :root, body {
        --mud-palette-background: #0b0c10 !important;
        --mud-palette-surface: #13141c !important;
    }
</style>