@inherits LayoutComponentBase

<MudThemeProvider Theme="_geoStrikeTheme" DefaultScrollbar="true" IsDarkMode="true"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<div class="page">
    <main>
        <div class="top-row px-4">
            <PlayerHud/>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

    <div class="bottom-bar">
        <NavMenu/>
    </div>
</div>

<style>
    body, html {
        background-color: #0b0c10 !important;
    }
</style>